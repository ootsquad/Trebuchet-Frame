# Set these in Railway > your service > Variables. Never commit real values.

# Discord
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# The development server (leaks source and important suggestions live there)
DISCORD_DEV_GUILD_ID=
BRAND_NAME=UNSC
BRAND_COLOR=5B8DEF
TIME_ZONE=America/New_York

# Channels (right click a channel > Copy Channel ID, with Developer Mode on)
CHANNEL_SUGGESTIONS=
CHANNEL_IMPORTANT_SUGGESTIONS=
CHANNEL_LEAKS_SOURCE=
CHANNEL_LEAKS=
CHANNEL_ANNOUNCEMENTS=
CHANNEL_WAVE_APPLICATIONS=
CHANNEL_EVENT_LOGS=
CHANNEL_PROMOTIONS=
CHANNEL_RANK_LOGS=
CHANNEL_RANK_PANEL=1572500360214483026
# Weekly leaderboard posts (empty = /leaderboard only, no weekly post)
CHANNEL_LEADERBOARDS=
# Where /schedule posts events (empty = the announcements channel)
CHANNEL_EVENT_SCHEDULE=
CHANNEL_SERVER_STATUS=1572511237370155048
# Weekly leaderboard post: day (0 Sunday ... 6 Saturday) and hour, in TIME_ZONE
LEADERBOARD_DAY=1
LEADERBOARD_HOUR=12

# Roles
ROLE_WAVE_MODERATOR=
ROLE_UNWAVED=
ROLE_COMMUNITY_MEMBER=
ROLE_EVENT_HOST=
ROLE_ANNOUNCER=
ROLE_LEAKER=
ROLE_ECONOMY_ADMIN=
# Pinged by /announce when you pick "Event notifications role"
ROLE_EVENT_NOTIFICATIONS=

# Suggestions
SUGGESTION_UPVOTES=25
SUGGESTION_UPVOTE_EMOJI=✅
SUGGESTION_DOWNVOTE_EMOJI=❌
SUGGESTION_THREADS=true

# Leaks
LEAKS_THUMBNAIL_URL=
LEAKS_ICON_URL=
LEAKS_COLOR=8FA3AD
# damascus, swanbourne, ganymede or perihelion. A post can pick one with [ganymede] on its first line.
LEAKS_FACILITY=damascus
LEAKS_SETTING_YEAR=2524
LEAKS_CLASSIFICATION=RESTRICTED  ·  ONI SECTION THREE

# Roblox. Make the Open Cloud key while signed in as the account ranked Artificial Intelligence in every group.
# It needs Groups read and write, and data store read and write on the game's universe.
ROBLOX_API_KEY=
# Optional: a separate key for the game's data store, if the game is owned by a group.
ROBLOX_DATASTORE_API_KEY=
ROBLOX_UNIVERSE_ID=
ROBLOX_ECONOMY_STORE=TrebuchetEconomyV1

# Groups (the known ones already have these defaults)
GROUP_PROJECT_ID=1039001311
GROUP_UNSC_ID=4615211
GROUP_MARINES_ID=4615235
GROUP_ODST_ID=547482530
GROUP_1ST_MID_ID=106191092
GROUP_3RD_MFR_ID=126808444
GROUP_MATERIALS_ID=911082331
GROUP_VEHICLES_ID=287151398
GROUP_NAVY_ID=4615237
GROUP_75TH_AAR_ID=271436257
GROUP_7TH_MCSB_ID=512707313
# The role waving gives in Project: Trebuchet
PROJECT_WAVED_ROLE=Waved
# UNSC rank for someone who is no longer in any marine, naval or Materials Group group
UNSC_LEFT_RANK=Registered Civilian
# Merit needed for each step up a group's ladder
MERIT_PER_RANK=200

# Rank sync. Leave SYNC_DRY_RUN=true until the previews in the rank log look right.
SYNC_EVERY_MINUTES=15
SYNC_DRY_RUN=true
SYNC_MAX_CHANGES=100

# Wave applications
APPLICATION_ON_JOIN=true
APPLICATION_MIN_AGE=13

# Events
HOST_COOLDOWN_HOURS=3
AUTO_PROMOTE=true

# Storage. On Railway, add a Volume and mount it at /data, then set DATA_DIR=/data.
DATA_DIR=./data

# Blacklist: Roblox user IDs allowed to use /blacklist (xaiver, sepernts)
BLACKLIST_ADMIN_IDS=497730291,25698705
# Roblox user IDs that may manage every rank in every group (xaiver, sepernts)
SUPER_ADMIN_IDS=497730291,25698705
